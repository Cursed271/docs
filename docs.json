{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "CursedSec Wiki",
  "description": "Onboarding, employee handbook, HR guides, IT help, company policies, and department runbooks.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#4C1D95"
  },
  "icons": {
    "library": "tabler"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "groups": []
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Employee portal",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "dark": "#262626"
    }
  },
  "interaction": {
    "drilldown": true
  }
}
